# =====================================================================
# Ajustes del servidor para DonWeb (y cualquier hosting con Apache o LiteSpeed).
# Es el equivalente del archivo _headers que usa Netlify. Netlify ignora este archivo,
# y Apache ignora _headers: pueden convivir en la carpeta sin problema.
# =====================================================================

# 1. HTTPS (el candado): NO se fuerza desde acá. En DonWeb la conexión segura la resuelve
#    un servidor anterior y este archivo ve todo como "http": una regla de "forzar HTTPS"
#    manda la página a sí misma sin fin y el sitio no abre (pasó el 22/10/2026).
#    Para forzarlo, usar la opción del panel del hosting (Certificados SSL).
RewriteEngine On

# 2. Una sola dirección para Google: corban.com.ar/
#    /index.html, /index.html/ (dirección vieja del WordPress) y /catalogo/… van a la principal.
RewriteCond %{THE_REQUEST} \s/catalogo/(\S*)\s
RewriteRule ^ https://%{HTTP_HOST}/%1 [L,R=301,NE]
RewriteCond %{THE_REQUEST} \s/index\.html
RewriteRule ^ https://%{HTTP_HOST}/ [L,R=301]

#    Direcciones del WordPress anterior que Google todavía muestra: van a la sección equivalente.
RewriteRule ^nosotros/?$ https://%{HTTP_HOST}/?pagina=quienes-somos [L,R=301]
RewriteRule ^contacto/?$ https://%{HTTP_HOST}/?pagina=contacto [L,R=301]
RewriteRule ^productos/?$ https://%{HTTP_HOST}/ [L,R=301]
#    Cualquier otra página vieja terminada en "/" que ya no existe: al catálogo (no toca fotos ni archivos).
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^.+/$ https://%{HTTP_HOST}/ [L,R=301]

# 3. Cuánto guarda el celular del visitante cada archivo. DonWeb, por su cuenta, guarda
#    estilos, fuentes y fotos 7 días: esto lo corrige. El código del sitio (html, css, js)
#    se revisa siempre, así un cambio publicado se ve enseguida.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
  ExpiresByType text/javascript "access plus 0 seconds"
  ExpiresByType image/webp "access plus 1 day"
  ExpiresByType image/jpeg "access plus 1 day"
  ExpiresByType image/png "access plus 1 day"
  ExpiresByType image/svg+xml "access plus 1 day"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # 4. Seguridad básica
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # 5. Lo mismo que el punto 3, para servidores que no usan mod_expires.
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(webp|jpg|jpeg|png|svg)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>
